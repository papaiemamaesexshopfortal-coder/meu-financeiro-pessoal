{
  "name": "meu-financeiro-pessoal",
  "version": "1.0.0",
  "private": true,
  "description": "Aplicativo financeiro pessoal",
  "scripts": {
    "copy:web": "node scripts/copy-web.js",
    "android:sync": "npm run copy:web && cap sync android",
    "ios:sync": "npm run build && npm run copy:web && cap sync ios && node scripts/configure-ios.js",
    "build": "node scripts/generate-app-icons.js && node scripts/bundle-sdk.js && node scripts/check-inline-js.js && node scripts/security-headers.js",
    "test": "node scripts/run-tests.js",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/share": "8.0.3",
    "@supabase/supabase-js": "2.57.4"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/cli": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@types/node": "22.18.6",
    "esbuild": "0.25.10",
    "jsdom": "26.1.0",
    "sharp": "0.35.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "xcode": "3.0.1"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": ">=22"
  }
}

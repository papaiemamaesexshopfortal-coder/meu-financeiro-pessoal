# Asaas — configuração segura
# Configure estas variáveis exclusivamente no ambiente do servidor (Vercel).
# Nunca publique valores reais no GitHub ou no JavaScript do navegador.
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_ENVIRONMENT=sandbox
SUPABASE_URL=https://mjiopkegmtmqwvvikxih.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Webhook Asaas: https://SEU_DOMINIO/api/billing/webhook
# Habilite eventos PAYMENT_RECEIVED, PAYMENT_CONFIRMED, PAYMENT_OVERDUE,
# PAYMENT_REFUNDED, PAYMENT_CHARGEBACK_REQUESTED, SUBSCRIPTION_DELETED.
# Configure o mesmo token em ASAAS_WEBHOOK_TOKEN e na autenticação do webhook no Asaas.
# Use somente Sandbox nesta versão. O modo production permanece bloqueado no código até nova homologação e revisão.

# Cobranças de produção estão bloqueadas no código até validação completa.
BILLING_SANDBOX_ENABLED=false
# Apenas UUIDs de usuários de teste autorizados; nunca contas de clientes.
BILLING_TEST_USER_IDS=
